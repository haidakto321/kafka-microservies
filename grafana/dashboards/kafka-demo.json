{
  "uid": "kafka-demo",
  "title": "Kafka microservices demo",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "HTTP requests per second",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (job) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{job}}" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "HTTP p95 latency (seconds)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_requests_seconds_bucket[1m])))", "legendFormat": "{{job}}" } ]
    },
    {
      "id": 3, "type": "timeseries", "title": "HTTP 5xx errors per second",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (job) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))", "legendFormat": "{{job}}" } ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Kafka consumer lag (messages)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (job, topic) (kafka_consumer_fetch_manager_records_lag)", "legendFormat": "{{job}} {{topic}}" } ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Circuit breaker state (1 = current state)",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "resilience4j_circuitbreaker_state{name=\"inventory\"}", "legendFormat": "{{state}}" } ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Outbox rows waiting to be sent",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "outbox_unpublished", "legendFormat": "{{job}}" } ]
    }
  ]
}
